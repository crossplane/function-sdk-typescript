{
  "name": "@crossplane-org/function-sdk-typescript",
  "version": "0.7.0",
  "description": "A Crossplane Function SDK for Typescript",
  "keywords": [
    "crossplane",
    "kubernetes",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crossplane/function-sdk-typescript"
  },
  "license": "Apache-2.0",
  "author": "Steven Borrelli",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "scripts/clean.sh",
    "protoc-gen": "scripts/protoc-gen.sh",
    "build": "npx tsc",
    "typecheck": "npx tsc -p tsconfig.eslint.json --noEmit",
    "pack": "npm pack",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck:legacy": "npx tsc6 --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@grpc/grpc-js": "^1.14.3",
    "kubernetes-models": "^5.0.0",
    "pino": "^10.1.0",
    "ts-deepmerge": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^25.0.3",
    "@typescript/native": "npm:typescript@^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.0.2",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.12.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^5.0.0"
  }
}
