{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "labels": [
    "automated",
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group all non-major updates together",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "extends": [
        "helpers:pinGitHubActionDigests"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The `typescript` dependency is aliased to @typescript/typescript6 so that typescript-eslint still has a JavaScript compiler API to import; TypeScript 7 is installed alongside it as @typescript/native and provides `tsc`. Do not let the TS6 alias be bumped across the major. Remove this rule, and the alias, once typescript-eslint supports TypeScript 7.",
      "matchPackageNames": [
        "@typescript/typescript6"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "schedule": [
    "after 10pm on sunday",
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}
